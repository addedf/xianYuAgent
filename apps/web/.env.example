# 不配置连接时，Web 界面自动使用演示数据。
APP_DEMO_MODE=true

# PostgreSQL 示例：postgresql://用户名:密码@127.0.0.1:5432/xianyu_agent
DATABASE_URL=

# 当前机器的 Redis 已启用认证。
# 示例：redis://:密码@127.0.0.1:6379/0
REDIS_URL=

# 企业微信机器人 Webhook。严禁提交真实值。
WECOM_WEBHOOK_URL=

# 本地只读闲鱼采集器（兼容 xianyu_spider 的 /search/ 与 xianyu_products 表）。
# 采集器必须由用户本人完成登录，只允许本机回环地址。
XIANYU_COLLECTOR_ENABLED=false
XIANYU_COLLECTOR_URL=http://127.0.0.1:8000
# 留空时与 DATABASE_URL 使用同一个 PostgreSQL；也可指定另一座本机数据库。
XIANYU_COLLECTOR_DATABASE_URL=

# 安全总开关。真实闲鱼发送适配器接入前必须保持 false。
OUTBOUND_MESSAGING_ENABLED=false
